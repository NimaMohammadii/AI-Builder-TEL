{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "builder-tel",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_NAME": "AI Builder TEL",
    "PUBLIC_BASE_URL": "http://localhost:8787",
    "OPENAI_BASE_URL": "https://api.openai.com/v1",
    "OPENAI_MODEL": "gpt-4.1-mini"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-builder-tel",
      "database_id": "0528d473-3f29-48b2-a659-8226ea7356dc"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "bot-builder-TEL",
      "id": "f2eb4c7696e74cc9ad889b048c87fc95"
    },
    {
      "binding": "RATE_LIMITS",
      "id": "00000000000000000000000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "ai-builder-tel-assets"
    }
  ]
}
