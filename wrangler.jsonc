{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "builder-tel",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "development",
    "OPENAI_MODEL": "gpt-4.1-mini"
  }
}
