{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "builder-tel",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "development",
    "OPENAI_MODEL": "gpt-5.4"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vexa-prod",
      "database_id": "504f42e2-9098-429f-b296-942ea435ba4e"
    }
  ]
}
