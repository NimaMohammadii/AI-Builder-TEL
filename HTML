];

// ── LEADERBOARD ──
const LB = [
  {name:'PHANTOM_01',score:288400},
  {name:'DARKNODE',  score:175200},
  {name:'VXR_99',    score:98600},
  {name:'NULLVOID',  score:42100},
  {name:'VEXER',     score:0, you:true},
];

// ── TABS ──
let curTab='home', curUpgTab='click', curMTab='active';

function goTab(tab) {
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  document.querySelectorAll('.nav-b').forEach(b=>b.classList.remove('active'));
  document.getElementById('screen-'+tab).classList.add('active');
  document.querySelector(`[data-tab="${tab}"]`).classList.add('active');
  curTab=tab;
  if(tab==='missions') document.getElementById('m-badge').style.display='none';
  if(tab==='bots')     renderBots();
  if(tab==='upgrades') renderUpgrades();
  if(tab==='missions') renderMissions();
  if(tab==='profile')  renderProfile();
}
function setUpgTab(t,el) {
  document.querySelectorAll('#screen-upgrades .tab').forEach(x=>x.classList.remove('active'));
  el.classList.add('active'); curUpgTab=t; renderUpgrades();
}
function setMTab(t,el) {
  document.querySelectorAll('#screen-missions .tab').forEach(x=>x.classList.remove('active'));
  el.classList.add('active'); curMTab=t; renderMissions();
}

// ── RENDER UPGRADES ──
function renderUpgrades() {
  const list=document.getElementById('upg-list'); list.innerHTML='';
  UPGRADES[curUpgTab].forEach(u=>{
    const bought=S.upgrades[u.id], afford=S.score>=u.cost;
    const d=document.createElement('div');
    d.className='upg-item'+(bought?' done':'');
    d.innerHTML=`
      <div class="upg-icon-box">${u.icon}</div>
      <div class="upg-info"><div class="upg-name">${u.name}</div><div class="upg-desc">${u.desc}</div></div>
      <div class="upg-right">
        ${bought
          ? `<div>${SVG.check}</div>`
          : `<div class="upg-cost${afford?' can':''}">${fmt(u.cost)}</div><div class="upg-bonus">${u.bonus}</div>`
        }
      </div>`;
    if(!bought) d.onclick=()=>buyUpg(u);
    list.appendChild(d);
  });
}

function buyUpg(u) {
  if(S.score<u.cost||S.upgrades[u.id]) return;
  S.score-=u.cost; S.upgrades[u.id]=true; u.fx();
  showToast(u.name+' PURCHASED'); renderUpgrades(); updateUI();
}

// ── QUICK GRID ──
function renderQuick() {
  const g=document.getElementById('quick-grid'); g.innerHTML='';
  const all=[...UPGRADES.click,...UPGRADES.passive,...UPGRADES.special];
  all.filter(u=>!S.upgrades[u.id]).slice(0,4).forEach(u=>{
    const afford=S.score>=u.cost;
    const d=document.createElement('div'); d.className='qcard';
    d.innerHTML=`
      <div class="qcard-icon">${u.icon}</div>
      <div class="qcard-name">${u.name}</div>
      <div class="qcard-desc">${u.desc}</div>
      <div class="qcard-cost${afford?' can':''}">${fmt(u.cost)}</div>`;
    d.onclick=()=>{buyUpg(u);renderQuick();};
    g.appendChild(d);
  });
}

// ── RENDER BOTS ──
function renderBots() {
  const list=document.getElementById('bots-list'); list.innerHTML='';
  BOTS.forEach(b=>{
    const cnt=S.bots[b.id], cost=Math.floor(b.base*Math.pow(b.mult,cnt)), afford=S.score>=cost;
    const d=document.createElement('div'); d.className='bot-card';
    d.innerHTML=`
      <div class="bot-top">
        <div class="bot-icon-box">${b.icon}<div class="bot-badge">${cnt}</div></div>
        <div class="bot-info"><div class="bot-name">${b.name}</div><div class="bot-desc">${b.desc}</div></div>
      </div>
      <div class="bot-stats">
        <div class="bst"><div class="bst-l">OWNED</div><div class="bst-v">${cnt}</div></div>
        <div class="bst"><div class="bst-l">PER SEC</div><div class="bst-v">${b.pps}</div></div>
        <div class="bst"><div class="bst-l">TOTAL/S</div><div class="bst-v">${b.pps*cnt}</div></div>
      </div>
      <button class="bot-btn${afford?'':' off'}" data-id="${b.id}">BUY — ${fmt(cost)} POWER</button>`;
    d.querySelector('.bot-btn').onclick=()=>buyBot(b);
    list.appendChild(d);
  });
  document.getElementById('pb-val').textContent='+'+S.pps;
}

function buyBot(b) {
  const cost=Math.floor(b.base*Math.pow(b.mult,S.bots[b.id]));
  if(S.score<cost){showToast('NOT ENOUGH POWER');return;}
  S.score-=cost; S.bots[b.id]++; S.pps+=b.pps;
  showToast(b.name+' DEPLOYED'); renderBots(); updateUI();
}

// ── MISSION PROGRESS ──
function mProg(m) {
  if(m.key==='clicks') return S.clicks;
  if(m.key==='total')  return S.total;
  if(m.key==='tbots')  return Object.values(S.bots).reduce((a,x)=>a+x,0);
  if(m.key==='level')  return S.level;
  return 0;
}

// ── RENDER MISSIONS ──
function renderMissions() {
  const list=document.getElementById('missions-list'); list.innerHTML='';
  const filtered=MISSIONS.filter(m=>{
    if(curMTab==='done')   return S.missions[m.id].claimed;
    if(curMTab==='daily')  return m.type==='daily'&&!S.missions[m.id].claimed;
    return m.type==='active'&&!S.missions[m.id].claimed;
  });

  let done=0, rew=0;
  MISSIONS.forEach(m=>{if(S.missions[m.id].claimed){done++;rew+=m.reward;}});
  document.getElementById('m-done').textContent=done;
  document.getElementById('m-rew').textContent=fmt(rew);
  document.getElementById('m-total').textContent=MISSIONS.length;

  if(!filtered.length){
    list.innerHTML='<div style="text-align:center;padding:40px;font-size:7px;letter-spacing:3px;color:var(--dim)">NO MISSIONS HERE</div>';
    return;
  }
  filtered.forEach(m=>{
    const prog=mProg(m), pct=Math.min((prog/m.target)*100,100);
    const rdy=prog>=m.target, claimed=S.missions[m.id].claimed;
    const d=document.createElement('div'); d.className='mc'+(claimed?' done':'');
    d.innerHTML=`
      <div class="mc-top">
        <div class="mc-icon-box">${m.icon}</div>
        <div class="mc-info">
          <div class="mc-name">${m.name}</div>
          <div class="mc-desc">${m.desc}</div>
          <div class="mc-rew">REWARD: ${fmt(m.reward)} POWER</div>
        </div>
      </div>
      <div class="mc-prog"><div class="mc-fill" style="width:${pct}%"></div></div>
      <div class="mc-row"><span>PROGRESS</span><span>${fmt(Math.min(prog,m.target))} / ${fmt(m.target)}</span></div>
      ${rdy&&!claimed?`<button class="mc-claim" data-id="${m.id}">CLAIM REWARD →</button>`:''}
      ${claimed?`<div class="mc-done">${SVG.check} COMPLETED</div>`:''}
    `;
    if(rdy&&!claimed) d.querySelector('.mc-claim').onclick=()=>claimM(m);
    list.appendChild(d);
  });
}

function claimM(m) {
  S.missions[m.id].claimed=true; S.score+=m.reward; S.total+=m.reward;
  showToast('+'+fmt(m.reward)+' POWER CLAIMED'); renderMissions(); updateUI();
}

// ── RENDER PROFILE ──
function renderProfile() {
  document.getElementById('p-score').textContent=fmt(S.total);
  document.getElementById('p-lvl').textContent=S.level;
  document.getElementById('p-clicks').textContent=fmt(S.clicks);
  document.getElementById('p-bots').textContent=Object.values(S.bots).reduce((a,x)=>a+x,0);
  document.getElementById('p-rank').textContent=rank(S.level);

  const ag=document.getElementById('ach-grid'); ag.innerHTML='';
  ACHS.forEach(a=>{
    const ok=a.ok();
    const d=document.createElement('div'); d.className='ach-c '+(ok?'unlocked':'locked');
    d.innerHTML=`${a.icon}<div class="ach-lbl">${a.name}</div>`;
    ag.appendChild(d);
  });

  LB.find(l=>l.you).score=S.total;
  const sorted=[...LB].sort((a,b)=>b.score-a.score);
  const lbw=document.getElementById('lb-wrap'); lbw.innerHTML='';
  sorted.forEach((l,i)=>{
    const d=document.createElement('div'); d.className='lb-item'+(l.you?' you':'');
    d.innerHTML=`
      <div class="lb-rank${i<3?' top':''}">${i+1}</div>
      <div class="lb-name">${l.name}${l.you?' (YOU)':''}</div>
      <div class="lb-sc">${fmt(l.score)}</div>`;
    lbw.appendChild(d);
  });
}

// ── CLICK ──
document.getElementById('main-btn').addEventListener('click', function(e) {
  S.score+=S.cpc; S.total+=S.cpc; S.clicks++;
  checkLevel(); updateUI();

  const rect=this.getBoundingClientRect();
  const ring=document.createElement('div'); ring.className='burst-ring';
  ring.style.cssText=`left:${rect.left}px;top:${rect.top}px;width:${rect.width}px;height:${rect.height}px;`;
  document.body.appendChild(ring);
  ring.addEventListener('animationend',()=>ring.remove());

  const fn=document.createElement('div'); fn.className='float-pts';
  fn.textContent='+'+S.cpc;
  fn.style.cssText=`left:${e.clientX-14}px;top:${e.clientY-10}px;`;
  document.body.appendChild(fn);
  fn.addEventListener('animationend',()=>fn.remove());

  const sd=document.getElementById('score-display');
  sd.classList.remove('pop'); void sd.offsetWidth; sd.classList.add('pop');
  setTimeout(()=>sd.classList.remove('pop'),80);
});

// ── PASSIVE ──
setInterval(()=>{
  if(S.pps>0){S.score+=S.pps; S.total+=S.pps; checkLevel(); updateUI();}
},1000);

// ── LEVEL UP ──
function checkLevel() {
  while(S.score>=lvlT(S.level)){
    S.level++;
    showToast('LEVEL '+String(S.level).padStart(2,'0')+' — '+rank(S.level));
  }
}

// ── UI UPDATE ──
function updateUI() {
  document.getElementById('score-display').textContent=fmt(S.score);
  document.getElementById('h-lvl').textContent=String(S.level).padStart(2,'0');
  document.getElementById('d-cpc').textContent=S.cpc;
  document.getElementById('d-cps').textContent=S.pps;
  document.getElementById('click-power-lbl').textContent='PWR '+S.cpc;
  document.getElementById('h-clicks').textContent=fmt(S.clicks);
  document.getElementById('h-bots').textContent=Object.values(S.bots).reduce((a,x)=>a+x,0);
  document.getElementById('h-rank').textContent=rank(S.level);

  const t=lvlT(S.level), pct=Math.min((S.score/t)*100,100);
  document.getElementById('prog-fill').style.width=pct+'%';
  document.getElementById('prog-lbl').textContent=fmt(S.score)+' / '+fmt(t);

  const claimable=MISSIONS.filter(m=>!S.missions[m.id].claimed&&mProg(m)>=m.target).length;
  const badge=document.getElementById('m-badge');
  badge.style.display=claimable>0?'flex':'none';
  badge.textContent=claimable;

  renderQuick();
  if(curTab==='bots') document.getElementById('pb-val').textContent='+'+S.pps;
}

// ── TOAST ──
let toastT;
function showToast(msg) {
  const t=document.getElementById('toast');
  t.textContent=msg; t.classList.add('show');
  clearTimeout(toastT); toastT=setTimeout(()=>t.classList.remove('show'),2200);
}

// ── NAV SVG COLOR FIX ──
// Make nav SVGs respond to active state
document.querySelectorAll('.nav-b svg').forEach(svg => {
  svg.querySelectorAll('[stroke]').forEach(el => {
    el.setAttribute('stroke', 'currentColor');
    el.removeAttribute('style');
  });
  svg.style.color = 'inherit';
});
document.querySelectorAll('.nav-b').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.nav-b svg').forEach(s => s.style.color = 'var(--dim)');
    btn.querySelector('svg').style.color = 'var(--wine3)';
  });
});

// ── INIT ──
renderQuick(); updateUI();
</script>

</body>
