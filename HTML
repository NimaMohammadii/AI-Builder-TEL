<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>VEX</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300&display=swap');

*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }

:root {
–bg0: #07050a;
–bg1: #0d0710;
–wine: #7b1d2e;
–wine2: #a8243a;
–wine3: #c42b44;
–wineglow: rgba(168,36,58,0.25);
–wineglow2: rgba(168,36,58,0.08);
–glass-bg: rgba(255,255,255,0.04);
–glass-bg2: rgba(255,255,255,0.07);
–glass-border: rgba(255,255,255,0.08);
–glass-border2: rgba(255,255,255,0.14);
–glass-shine: rgba(255,255,255,0.12);
–white: #f4f0f2;
–white2: rgba(244,240,242,0.7);
–dim: rgba(244,240,242,0.28);
–dim2: rgba(244,240,242,0.12);
–font-display: ‘Bebas Neue’, sans-serif;
–font-body: ‘DM Mono’, monospace;
}

html, body { height:100%; overflow:hidden; background:var(–bg0); }

body {
font-family: var(–font-body);
color: var(–white);
display: flex;
flex-direction: column;
align-items: center;
max-width: 430px;
margin: 0 auto;
position: relative;
}

/* ─── BACKGROUND BLOBS ─── */
.bg-layer {
position: fixed; inset: 0;
pointer-events: none; z-index: 0;
overflow: hidden;
}
.blob {
position: absolute;
border-radius: 50%;
filter: blur(80px);
opacity: 0.18;
}
.blob-1 { width:340px; height:340px; background:var(–wine2); top:-80px; left:-60px; animation:drift1 12s ease-in-out infinite alternate; }
.blob-2 { width:280px; height:280px; background:#1a0a2e; top:200px; right:-80px; animation:drift2 15s ease-in-out infinite alternate; }
.blob-3 { width:220px; height:220px; background:var(–wine); bottom:100px; left:30px; animation:drift3 10s ease-in-out infinite alternate; }
@keyframes drift1 { to { transform:translate(30px,40px) scale(1.1); } }
@keyframes drift2 { to { transform:translate(-20px,30px) scale(0.9); } }
@keyframes drift3 { to { transform:translate(40px,-20px) scale(1.15); } }

/* ─── GLASS MIXIN ─── */
.glass {
background: var(–glass-bg);
backdrop-filter: blur(20px) saturate(160%);
-webkit-backdrop-filter: blur(20px) saturate(160%);
border: 1px solid var(–glass-border);
position: relative;
}
.glass::before {
content:’’;
position:absolute; inset:0;
border-radius: inherit;
background: linear-gradient(135deg, var(–glass-shine) 0%, transparent 50%);
pointer-events:none;
}

/* ─── HEADER ─── */
.header {
width:100%; flex-shrink:0;
display:flex; align-items:center; justify-content:space-between;
padding:16px 18px 14px;
background: rgba(7,5,10,0.6);
backdrop-filter: blur(30px);
-webkit-backdrop-filter: blur(30px);
border-bottom: 1px solid var(–glass-border);
position: relative; z-index: 10;
}
.header::after {
content:’’;
position:absolute; bottom:0; left:15%; right:15%; height:1px;
background: linear-gradient(90deg, transparent, var(–wine2), transparent);
opacity:0.6;
}
.logo {
font-family: var(–font-display);
font-size:26px; letter-spacing:10px;
color: var(–white);
}
.logo-x { color: var(–wine3); }
.header-right { display:flex; align-items:center; gap:9px; }

.lvl-pill {
font-size:8px; letter-spacing:3px; color:var(–wine3);
background: rgba(168,36,58,0.12);
border: 1px solid rgba(168,36,58,0.3);
padding:4px 10px;
backdrop-filter: blur(10px);
}
.icon-btn {
width:32px; height:32px;
background:var(–glass-bg); border:1px solid var(–glass-border);
backdrop-filter:blur(10px);
display:flex; align-items:center; justify-content:center;
cursor:pointer; transition:border-color 0.2s;
}
.icon-btn:hover { border-color: var(–wine2); }
.notif-dot {
position:absolute; top:6px; right:6px;
width:5px; height:5px; background:var(–wine3); border-radius:50%;
}

/* ─── SCREENS ─── */
.screens { flex:1; width:100%; overflow-y:auto; overflow-x:hidden; position:relative; z-index:1; scrollbar-width:none; }
.screens::-webkit-scrollbar { display:none; }
.screen { display:none; }
.screen.active { display:block; }

/* ─── HOME ─── */
.score-block { text-align:center; padding:22px 20px 0; }
.score-lbl { font-size:7px; letter-spacing:5px; color:var(–dim); margin-bottom:4px; }
.score-num {
font-family:var(–font-display);
font-size:64px; line-height:1; letter-spacing:2px;
transition: transform 0.06s;
text-shadow: 0 0 40px var(–wineglow);
}
.score-num.pop { transform:scale(1.05); }
.score-subs { display:flex; justify-content:center; gap:18px; margin-top:6px; }
.score-subs span { font-size:8px; letter-spacing:2px; color:var(–dim); }
.score-subs b { color:var(–wine3); }

/* CLICKER */
.clicker-area {
display:flex; align-items:center; justify-content:center;
padding:20px 0 14px; position:relative;
}
/* outer ring svg wrapper */
.click-wrap {
width:196px; height:196px;
position:relative; cursor:pointer;
-webkit-tap-highlight-color:transparent;
}
.click-wrap:active .click-core { transform:scale(0.90); }
.click-wrap:active .ring-svg-outer { opacity:0.4; }

.ring-svg-outer {
position:absolute; inset:0;
animation: spin-slow 30s linear infinite;
transition:opacity 0.1s;
}
.ring-svg-mid {
position:absolute; inset:14px;
animation: spin-slow 18s linear infinite reverse;
}

.click-core {
position:absolute; inset:38px;
border-radius:50%;
background: radial-gradient(circle at 38% 32%, rgba(168,36,58,0.18) 0%, rgba(7,5,10,0.9) 65%);
backdrop-filter: blur(16px) saturate(180%);
-webkit-backdrop-filter: blur(16px) saturate(180%);
border: 1px solid rgba(168,36,58,0.35);
display:flex; flex-direction:column; align-items:center; justify-content:center;
transition: transform 0.08s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.15s;
box-shadow: 0 0 30px var(–wineglow), inset 0 1px 0 rgba(255,255,255,0.08);
pointer-events:none;
}
.click-wrap:active .click-core {
box-shadow: 0 0 60px rgba(168,36,58,0.5), inset 0 1px 0 rgba(255,255,255,0.05);
}
.click-lbl {
font-family:var(–font-display);
font-size:28px; letter-spacing:7px;
color:var(–white);
text-shadow: 0 0 20px var(–wine3);
pointer-events:none;
}
.click-sub { font-size:7px; letter-spacing:3px; color:var(–wine3); pointer-events:none; margin-top:-2px; }

@keyframes spin-slow { to { transform:rotate(360deg); } }

/* RING BURST */
.burst-ring {
position:fixed;
border-radius:50%;
border:1px solid rgba(168,36,58,0.4);
pointer-events:none;
animation:burst 0.65s ease-out forwards;
z-index:500;
}
@keyframes burst { 0%{transform:scale(1);opacity:1} 100%{transform:scale(2.2);opacity:0} }
.float-pts {
position:fixed;
font-family:var(–font-display);
font-size:18px; color:var(–wine3);
pointer-events:none;
animation:floatup 0.85s ease-out forwards;
z-index:502;
text-shadow: 0 0 10px var(–wine3);
}
@keyframes floatup { 0%{opacity:1;transform:translateY(0)} 100%{opacity:0;transform:translateY(-65px) scale(0.6)} }

/* PROGRESS */
.prog-wrap { padding:2px 20px 12px; }
.prog-row { display:flex; justify-content:space-between; font-size:7px; letter-spacing:3px; color:var(–dim); margin-bottom:6px; }
.prog-track {
height:2px;
background:var(–dim2);
border-radius:2px;
overflow:visible;
position:relative;
}
.prog-fill {
height:2px;
background:linear-gradient(90deg, var(–wine), var(–wine3));
border-radius:2px;
transition:width 0.4s ease;
position:relative;
box-shadow:0 0 8px var(–wine3);
}
.prog-fill::after {
content:’’;
position:absolute; right:-3px; top:-3px;
width:8px; height:8px;
background:var(–wine3); border-radius:50%;
box-shadow:0 0 8px var(–wine3);
}

/* HOME STATS */
.home-stats { display:flex; margin:0 0 14px; border-top:1px solid var(–glass-border); border-bottom:1px solid var(–glass-border); }
.hst { flex:1; padding:11px 14px; border-right:1px solid var(–glass-border); }
.hst:last-child { border-right:none; }
.hst-lbl { font-size:6px; letter-spacing:3px; color:var(–dim); margin-bottom:3px; }
.hst-val { font-family:var(–font-display); font-size:19px; letter-spacing:2px; }

/* QUICK CARDS */
.qs { padding:0 16px 20px; }
.stitle {
font-size:7px; letter-spacing:4px; color:var(–dim);
margin-bottom:10px; padding-bottom:8px;
border-bottom:1px solid var(–glass-border);
display:flex; justify-content:space-between; align-items:center;
}
.stitle a { color:var(–wine3); cursor:pointer; font-size:6px; letter-spacing:2px; text-decoration:none; }
.quick-grid { display:grid; grid-template-columns:1fr 1fr; gap:8px; }

.qcard {
background:var(–glass-bg);
backdrop-filter:blur(18px) saturate(160%);
-webkit-backdrop-filter:blur(18px) saturate(160%);
border:1px solid var(–glass-border);
padding:13px 12px;
cursor:pointer;
transition:border-color 0.2s, background 0.2s;
position:relative; overflow:hidden;
}
.qcard::before {
content:’’;
position:absolute; inset:0;
background:linear-gradient(135deg, rgba(255,255,255,0.06) 0%, transparent 55%);
pointer-events:none;
}
.qcard:hover { border-color:rgba(168,36,58,0.5); background:rgba(168,36,58,0.06); }
.qcard-icon { margin-bottom:7px; }
.qcard-name { font-size:8px; letter-spacing:2px; margin-bottom:3px; }
.qcard-desc { font-size:6px; color:var(–dim); line-height:1.6; margin-bottom:7px; }
.qcard-cost { font-family:var(–font-display); font-size:14px; letter-spacing:1px; color:var(–wine3); }
.qcard-cost.can { color:var(–white); }

/* ─── PAGE HEADER ─── */
.page-h { padding:20px 20px 0; }
.page-h-title { font-family:var(–font-display); font-size:34px; letter-spacing:5px; margin-bottom:2px; }
.page-h-sub { font-size:7px; letter-spacing:4px; color:var(–dim); margin-bottom:18px; }

/* ─── TABS (shared) ─── */
.tabs {
display:flex; margin:0 16px 14px;
background:var(–glass-bg);
backdrop-filter:blur(20px);
border:1px solid var(–glass-border);
overflow:hidden;
}
.tab {
flex:1; padding:9px 0; text-align:center;
font-size:7px; letter-spacing:3px; color:var(–dim);
cursor:pointer; background:none; border:none;
border-right:1px solid var(–glass-border);
transition:all 0.2s;
}
.tab:last-child { border-right:none; }
.tab.active { background:rgba(168,36,58,0.14); color:var(–wine3); }

/* ─── UPGRADE LIST ─── */
.upg-list { padding:0 16px 20px; display:flex; flex-direction:column; gap:8px; }
.upg-item {
background:var(–glass-bg);
backdrop-filter:blur(18px);
-webkit-backdrop-filter:blur(18px);
border:1px solid var(–glass-border);
padding:13px 15px;
display:flex; align-items:center; gap:13px;
cursor:pointer; transition:border-color 0.2s, background 0.2s;
position:relative; overflow:hidden;
}
.upg-item::before {
content:’’;
position:absolute; inset:0;
background:linear-gradient(120deg, rgba(255,255,255,0.05) 0%, transparent 50%);
pointer-events:none;
}
.upg-item:hover { border-color:rgba(168,36,58,0.45); background:rgba(168,36,58,0.05); }
.upg-item.done { opacity:0.45; cursor:default; }
.upg-item.done:hover { border-color:var(–glass-border); background:var(–glass-bg); }
.upg-icon-box {
width:38px; height:38px; flex-shrink:0;
background:rgba(168,36,58,0.1);
border:1px solid rgba(168,36,58,0.25);
display:flex; align-items:center; justify-content:center;
}
.upg-info { flex:1; }
.upg-name { font-size:9px; letter-spacing:2px; margin-bottom:3px; }
.upg-desc { font-size:6px; color:var(–dim); line-height:1.6; }
.upg-right { text-align:right; flex-shrink:0; }
.upg-cost { font-family:var(–font-display); font-size:17px; letter-spacing:1px; color:var(–wine3); }
.upg-bonus { font-size:6px; color:var(–dim); letter-spacing:1px; }

/* ─── BOTS ─── */
.passive-banner {
margin:0 16px 14px;
background:rgba(168,36,58,0.1);
backdrop-filter:blur(20px);
border:1px solid rgba(168,36,58,0.3);
padding:14px 16px;
display:flex; justify-content:space-between; align-items:center;
position:relative; overflow:hidden;
}
.passive-banner::before {
content:’’;
position:absolute; inset:0;
background:linear-gradient(135deg, rgba(255,255,255,0.05) 0%, transparent 50%);
pointer-events:none;
}
.pb-lbl { font-size:7px; letter-spacing:3px; color:var(–wine3); margin-bottom:2px; }
.pb-sub { font-size:6px; letter-spacing:2px; color:var(–dim); }
.pb-val { font-family:var(–font-display); font-size:32px; letter-spacing:2px; color:var(–wine3); }

.bots-list { padding:0 16px 20px; display:flex; flex-direction:column; gap:10px; }
.bot-card {
background:var(–glass-bg);
backdrop-filter:blur(18px) saturate(160%);
-webkit-backdrop-filter:blur(18px) saturate(160%);
border:1px solid var(–glass-border);
padding:14px 15px;
position:relative; overflow:hidden;
}
.bot-card::before {
content:’’; position:absolute; inset:0;
background:linear-gradient(140deg, rgba(255,255,255,0.06) 0%, transparent 55%);
pointer-events:none;
}
.bot-top { display:flex; align-items:center; gap:12px; margin-bottom:10px; }
.bot-icon-box {
width:44px; height:44px; flex-shrink:0;
background:rgba(168,36,58,0.1);
border:1px solid rgba(168,36,58,0.2);
display:flex; align-items:center; justify-content:center;
position:relative;
}
.bot-badge {
position:absolute; top:-7px; right:-7px;
width:16px; height:16px;
background:var(–wine3); border-radius:50%;
font-family:var(–font-display); font-size:9px;
color:#fff; display:flex; align-items:center; justify-content:center;
}
.bot-info { flex:1; }
.bot-name { font-size:10px; letter-spacing:2px; margin-bottom:3px; }
.bot-desc { font-size:6px; color:var(–dim); }
.bot-stats {
display:flex;
border:1px solid var(–glass-border);
margin-bottom:10px;
}
.bst { flex:1; padding:7px 10px; border-right:1px solid var(–glass-border); }
.bst:last-child { border-right:none; }
.bst-l { font-size:6px; letter-spacing:2px; color:var(–dim); margin-bottom:2px; }
.bst-v { font-family:var(–font-display); font-size:15px; letter-spacing:1px; }
.bot-btn {
width:100%; padding:9px;
background:rgba(168,36,58,0.08);
backdrop-filter:blur(10px);
border:1px solid rgba(168,36,58,0.3);
color:var(–wine3);
font-family:var(–font-body); font-size:7px; letter-spacing:3px;
cursor:pointer; transition:all 0.2s;
}
.bot-btn:hover { background:rgba(168,36,58,0.18); }
.bot-btn.off { border-color:var(–glass-border); color:var(–dim); cursor:not-allowed; }
.bot-btn.off:hover { background:rgba(168,36,58,0.08); }

/* ─── MISSIONS ─── */
.missions-header { display:flex; gap:8px; margin:0 16px 14px; }
.mh-c {
flex:1; padding:12px;
background:var(–glass-bg);
backdrop-filter:blur(18px);
border:1px solid var(–glass-border);
text-align:center; position:relative; overflow:hidden;
}
.mh-c::before { content:’’; position:absolute; inset:0; background:linear-gradient(135deg,rgba(255,255,255,0.06) 0%,transparent 50%); pointer-events:none; }
.mhv { font-family:var(–font-display); font-size:26px; letter-spacing:2px; }
.mhv.w { color:var(–wine3); }
.mhl { font-size:6px; letter-spacing:2px; color:var(–dim); }

.missions-list { padding:0 16px 20px; display:flex; flex-direction:column; gap:9px; }
.mc {
background:var(–glass-bg);
backdrop-filter:blur(18px);
-webkit-backdrop-filter:blur(18px);
border:1px solid var(–glass-border);
padding:14px 15px;
position:relative; overflow:hidden;
}
.mc::before { content:’’; position:absolute; inset:0; background:linear-gradient(130deg,rgba(255,255,255,0.05) 0%,transparent 55%); pointer-events:none; }
.mc.done { border-color:rgba(168,36,58,0.25); }
.mc.done::after { content:’’; position:absolute; top:0; left:0; width:3px; height:100%; background:linear-gradient(180deg,var(–wine),var(–wine3)); }
.mc-top { display:flex; gap:12px; margin-bottom:10px; }
.mc-icon-box {
width:36px; height:36px; flex-shrink:0;
background:rgba(168,36,58,0.1);
border:1px solid rgba(168,36,58,0.2);
display:flex; align-items:center; justify-content:center;
}
.mc-info { flex:1; }
.mc-name { font-size:9px; letter-spacing:2px; margin-bottom:3px; }
.mc-desc { font-size:6px; color:var(–dim); line-height:1.6; }
.mc-rew { font-size:6px; letter-spacing:2px; color:var(–wine3); background:rgba(168,36,58,0.12); padding:2px 7px; display:inline-block; margin-top:4px; }
.mc-prog { height:2px; background:var(–dim2); position:relative; border-radius:2px; }
.mc-fill { height:2px; background:linear-gradient(90deg,var(–wine),var(–wine3)); border-radius:2px; box-shadow:0 0 6px var(–wine3); }
.mc-row { display:flex; justify-content:space-between; font-size:6px; color:var(–dim); margin-top:4px; }
.mc-claim {
width:100%; margin-top:10px; padding:8px;
background:rgba(168,36,58,0.12);
backdrop-filter:blur(10px);
border:1px solid rgba(168,36,58,0.4);
color:var(–wine3);
font-family:var(–font-body); font-size:7px; letter-spacing:3px;
cursor:pointer; transition:all 0.2s;
}
.mc-claim:hover { background:rgba(168,36,58,0.22); }
.mc-done { font-size:7px; letter-spacing:2px; color:var(–dim); text-align:center; padding:7px; border:1px solid var(–glass-border); margin-top:8px; }

/* ─── PROFILE ─── */
.prof-top {
text-align:center; padding:20px 20px;
border-bottom:1px solid var(–glass-border);
margin-bottom:16px;
}
.prof-avatar {
width:80px; height:80px; margin:0 auto 12px;
border-radius:50%;
background: radial-gradient(circle at 38% 32%, rgba(168,36,58,0.3), rgba(7,5,10,0.95));
border:1px solid rgba(168,36,58,0.4);
backdrop-filter:blur(20px);
display:flex; align-items:center; justify-content:center;
box-shadow:0 0 30px var(–wineglow), inset 0 1px 0 rgba(255,255,255,0.1);
}
.pa-letter { font-family:var(–font-display); font-size:38px; letter-spacing:4px; color:var(–wine3); }
.prof-name { font-family:var(–font-display); font-size:30px; letter-spacing:7px; }
.prof-rank {
font-size:8px; letter-spacing:4px; color:var(–wine3);
background:rgba(168,36,58,0.12); border:1px solid rgba(168,36,58,0.3);
display:inline-block; padding:3px 13px; margin-top:7px;
backdrop-filter:blur(10px);
}
.prof-since { font-size:7px; color:var(–dim); letter-spacing:2px; margin-top:7px; }

.prof-grid { display:grid; grid-template-columns:1fr 1fr; gap:8px; padding:0 16px 16px; }
.pg-c {
background:var(–glass-bg); backdrop-filter:blur(18px);
border:1px solid var(–glass-border);
padding:13px; position:relative; overflow:hidden;
}
.pg-c::before { content:’’; position:absolute; inset:0; background:linear-gradient(135deg,rgba(255,255,255,0.06) 0%,transparent 50%); pointer-events:none; }
.pgc-l { font-size:6px; letter-spacing:3px; color:var(–dim); margin-bottom:5px; }
.pgc-v { font-family:var(–font-display); font-size:22px; letter-spacing:2px; }
.pgc-v.w { color:var(–wine3); }

.ach-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:8px; padding:0 16px 16px; }
.ach-c {
background:var(–glass-bg); backdrop-filter:blur(18px);
border:1px solid var(–glass-border);
aspect-ratio:1;
display:flex; flex-direction:column; align-items:center; justify-content:center; gap:5px;
position:relative; overflow:hidden;
}
.ach-c::before { content:’’; position:absolute; inset:0; background:linear-gradient(135deg,rgba(255,255,255,0.06) 0%,transparent 55%); pointer-events:none; }
.ach-c.locked { opacity:0.25; }
.ach-c.unlocked { border-color:rgba(168,36,58,0.35); }
.ach-lbl { font-size:5px; letter-spacing:1px; color:var(–dim); text-align:center; padding:0 2px; }

.lb-wrap { padding:0 16px 30px; }
.lb-item {
display:flex; align-items:center; gap:12px;
padding:10px 14px;
background:var(–glass-bg); backdrop-filter:blur(18px);
border:1px solid var(–glass-border);
border-bottom:none; position:relative; overflow:hidden;
}
.lb-item::before { content:’’; position:absolute; inset:0; background:linear-gradient(120deg,rgba(255,255,255,0.04) 0%,transparent 50%); pointer-events:none; }
.lb-item:last-child { border-bottom:1px solid var(–glass-border); }
.lb-item.you { border-color:rgba(168,36,58,0.4); background:rgba(168,36,58,0.07); }
.lb-rank { font-family:var(–font-display); font-size:20px; letter-spacing:2px; color:var(–dim); width:26px; }
.lb-item.you .lb-rank { color:var(–wine3); }
